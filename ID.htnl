```html
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Universal Draft Battle</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/tone/14.8.49/Tone.js"></script>
    <link href="https://fonts.googleapis.com/css2?family=Bangers&family=Inter:wght@400;600;800&display=swap" rel="stylesheet">
    <style>
        body {
            font-family: 'Inter', sans-serif;
            background-color: #1a202c; 
            color: #f7fafc;
            overflow-x: hidden;
        }
        .bangers-font { font-family: 'Bangers', cursive; letter-spacing: 2px; }
        
        .comic-border { border: 4px solid; border-radius: 12px; }
        
        .slot-machine-container {
            height: 60px; overflow: hidden; position: relative;
            background: #2d3748; border-radius: 8px; border: 2px solid #4a5568;
        }
        .slot-items {
            position: absolute; width: 100%; transition: top 2s cubic-bezier(0.25, 1, 0.5, 1);
        }
        .slot-item {
            height: 60px; display: flex; align-items: center; justify-content: center;
            font-size: 1.25rem; font-weight: bold; color: white; text-shadow: 1px 1px 2px black; text-align: center;
        }
        .modal {
            display: none; position: fixed; z-index: 50; left: 0; top: 0; width: 100%; height: 100%;
            overflow: auto; background-color: rgba(0,0,0,0.8); backdrop-filter: blur(5px);
        }
        .modal-content { margin: 10% auto; width: 90%; max-width: 600px; animation: zoomIn 0.3s; }
        @keyframes zoomIn { from { transform: scale(0.5); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        
        .stat-row { display: flex; justify-content: space-between; align-items: center; padding: 4px 0; border-bottom: 1px solid #4a5568; }
        .stat-label { font-size: 0.75rem; color: #a0aec0; text-transform: uppercase; font-weight: bold; }
        .stat-val { font-size: 1.125rem; font-weight: 600; height: 1.75rem; }
    </style>
</head>
<body class="min-h-screen flex flex-col items-center p-4 relative" id="body-bg">

    <!-- Sound Toggle Button -->
    <button id="btn-mute" class="fixed top-4 right-4 bg-gray-800 p-3 rounded-full border-2 border-gray-600 text-2xl hover:bg-gray-700 transition-colors z-50 w-14 h-14 flex justify-center items-center">🔊</button>

    <!-- Header & Universe Selector -->
    <header class="text-center my-6 w-full max-w-4xl flex items-center justify-between">
        <button id="btn-prev-uni" class="text-4xl text-gray-400 hover:text-white transition transform hover:-translate-x-1">◀</button>
        <div class="flex-grow">
            <h1 id="main-title" class="text-5xl md:text-7xl bangers-font uppercase drop-shadow-md">Loading...</h1>
            <p class="text-xl mt-2 text-gray-300">Choose your game mode!</p>
        </div>
        <button id="btn-next-uni" class="text-4xl text-gray-400 hover:text-white transition transform hover:translate-x-1">▶</button>
    </header>

    <!-- Main Menu -->
    <div id="main-menu" class="w-full max-w-2xl flex flex-col gap-4">
        <button onclick="startGame('chimera')" class="bg-red-600 hover:bg-red-500 text-white bangers-font text-3xl py-4 px-8 rounded-lg border-b-4 border-red-800 transition transform hover:-translate-y-1">🗡️ Chimera Draft (1v1)</button>
        <button onclick="startGame('fusion')" class="bg-blue-600 hover:bg-blue-500 text-white bangers-font text-3xl py-4 px-8 rounded-lg border-b-4 border-blue-800 transition transform hover:-translate-y-1">🧬 Fusion Battle (2v2)</button>
        <button onclick="startGame('pvp')" class="bg-purple-600 hover:bg-purple-500 text-white bangers-font text-3xl py-4 px-8 rounded-lg border-b-4 border-purple-800 transition transform hover:-translate-y-1">🤝 PVP Pass & Play</button>
        <button onclick="startGame('aura')" class="bg-yellow-500 hover:bg-yellow-400 text-black bangers-font text-3xl py-4 px-8 rounded-lg border-b-4 border-yellow-700 transition transform hover:-translate-y-1">✨ Aura Guesser</button>
    </div>

    <!-- MAIN GAME CONTAINER -->
    <main class="w-full max-w-4xl flex flex-col gap-8 hidden relative" id="game-container">
        
        <!-- Setup Phase (Spin Opponent) -->
        <div id="setup-phase" class="hidden flex-col items-center bg-gray-800 p-8 comic-border text-center w-full">
            <h2 id="setup-title" class="text-3xl bangers-font text-white mb-4">Step 1: Discover Your Opponent</h2>
            <div class="w-full max-w-md"><div class="slot-machine-container mb-4"><div id="opponent-slot" class="slot-items top-0"></div></div></div>
            <button id="btn-spin-opponent" class="bg-red-600 hover:bg-red-500 text-white bangers-font text-2xl py-3 px-8 rounded border-b-4 border-red-800 mt-4">Spin</button>
            <div id="opponent-reveal" class="hidden mt-6">
                <p class="text-lg text-gray-300" id="setup-subtitle">Fighting Against:</p>
                <h3 id="opponent-name-display" class="text-4xl bangers-font mt-2"></h3>
                <button id="btn-start-draft" class="mt-6 bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 px-6 rounded">Start Drafting</button>
            </div>
        </div>

        <!-- Chimera Draft Phase -->
        <div id="draft-phase" class="hidden flex-col md:flex-row gap-6 w-full">
            <div class="w-full md:w-2/3 bg-gray-800 p-6 comic-border flex flex-col">
                <div class="flex justify-between items-center mb-6">
                    <h2 class="text-3xl bangers-font text-white" id="draft-turn-indicator">Draft Phase</h2>
                    <span class="bg-gray-700 px-3 py-1 rounded text-white text-sm"><span id="draft-progress">0</span>/8</span>
                </div>
                
                <div class="grid grid-cols-2 gap-4 mb-6">
                    <div class="flex flex-col items-center">
                        <div class="w-full slot-machine-container"><div id="draft-slot-a" class="slot-items top-0"></div></div>
                        <button id="btn-select-a" class="mt-4 w-full bg-green-600 hover:bg-green-500 text-white font-bold py-2 rounded disabled:opacity-50">Select A</button>
                    </div>
                    <div class="flex flex-col items-center">
                        <div class="w-full slot-machine-container"><div id="draft-slot-b" class="slot-items top-0"></div></div>
                        <button id="btn-select-b" class="mt-4 w-full bg-green-600 hover:bg-green-500 text-white font-bold py-2 rounded disabled:opacity-50">Select B</button>
                    </div>
                </div>
                
                <div class="flex justify-center gap-4 mt-auto">
                    <button id="btn-spin-draft" class="bg-yellow-500 hover:bg-yellow-400 text-black bangers-font text-2xl py-3 px-8 rounded w-full border-b-4 border-yellow-700">SPIN</button>
                    <button id="btn-reroll" class="bg-purple-600 hover:bg-purple-500 text-white bangers-font text-xl py-3 px-4 rounded border-b-4 border-purple-800 w-1/3 disabled:opacity-50" title="One use only!">REROLL</button>
                </div>

                <div id="assignment-panel" class="hidden flex-col items-center mt-6 p-4 bg-gray-700 rounded border-2 border-white">
                    <h3 class="text-xl text-white mb-3">Assign <span id="assign-char-name" class="font-bold bangers-font text-2xl"></span> to:</h3>
                    <div class="grid grid-cols-2 md:grid-cols-4 gap-2 w-full" id="category-buttons"></div>
                </div>
            </div>

            <!-- Stats Sidebar -->
            <div class="w-full md:w-1/3 bg-gray-900 p-6 border-2 border-gray-700 rounded-xl flex flex-col">
                <h3 class="text-2xl bangers-font text-white mb-4 text-center" id="sidebar-title">Your Fighter</h3>
                <div class="space-y-1 flex-grow" id="fighter-stats-container">
                    <!-- Populated via JS to keep HTML clean -->
                </div>
                <div class="mt-4 pt-4 border-t-2 border-gray-700 text-center text-sm text-gray-400">
                    <span id="streak-container">Streak: <span id="gauntlet-streak" class="text-white font-bold">0</span><br></span>
                    Vs: <span id="summary-opponent-name" class="font-bold text-white"></span>
                </div>
            </div>
        </div>

        <!-- PVP Intermission -->
        <div id="pvp-intermission" class="hidden flex-col items-center bg-gray-800 p-8 comic-border text-center w-full">
            <h2 class="text-5xl bangers-font text-white mb-4">Player 1 Done!</h2>
            <p class="text-xl text-gray-300 mb-8">Pass the device to Player 2.</p>
            <button onclick="startPlayer2Draft()" class="bg-blue-600 hover:bg-blue-500 text-white bangers-font text-3xl py-4 px-12 rounded">Player 2 Start</button>
        </div>

        <!-- Fusion Setup Phase -->
        <div id="fusion-setup-phase" class="hidden flex-col gap-6 w-full bg-gray-800 p-6 comic-border text-center">
            <h2 class="text-4xl bangers-font text-white mb-2">Build Your Fusions</h2>
            <p class="text-gray-300 mb-6">Spin 2 Base bodies, then spin 2 Partners to fuse into them!</p>
            
            <div class="flex gap-4 w-full">
                <div class="w-1/2 p-4 bg-gray-700 rounded border border-gray-600">
                    <h3 class="text-xl bangers-font text-blue-400 mb-2">Bases</h3>
                    <div class="slot-machine-container mb-2"><div id="fusion-base-1" class="slot-items top-0"></div></div>
                    <div class="slot-machine-container mb-4"><div id="fusion-base-2" class="slot-items top-0"></div></div>
                    <button id="btn-spin-bases" class="w-full bg-blue-600 text-white py-2 font-bold rounded">Spin Bases</button>
                </div>
                <div class="w-1/2 p-4 bg-gray-700 rounded border border-gray-600">
                    <h3 class="text-xl bangers-font text-green-400 mb-2">Partners</h3>
                    <div class="slot-machine-container mb-2"><div id="fusion-partner-1" class="slot-items top-0"></div></div>
                    <div class="slot-machine-container mb-4"><div id="fusion-partner-2" class="slot-items top-0"></div></div>
                    <button id="btn-spin-partners" class="w-full bg-green-600 text-white py-2 font-bold rounded disabled:opacity-50" disabled>Spin Partners</button>
                </div>
            </div>
            
            <div id="fusion-assignment" class="hidden mt-6 p-4 bg-gray-900 rounded">
                <h3 class="text-xl text-white mb-4">Assign Partners to Bases:</h3>
                <div class="flex justify-around items-center">
                    <div class="flex flex-col items-center">
                        <span id="label-base-1" class="font-bold text-lg mb-2"></span>
                        <select id="select-partner-1" class="p-2 rounded bg-gray-700 text-white text-center w-40"></select>
                    </div>
                    <div class="text-2xl font-bold">+</div>
                    <div class="flex flex-col items-center">
                        <span id="label-base-2" class="font-bold text-lg mb-2"></span>
                        <span id="label-partner-2" class="p-2 text-gray-400">Auto-assigned</span>
                    </div>
                </div>
                <button id="btn-lock-fusions" class="mt-6 bg-yellow-500 text-black bangers-font text-2xl py-2 px-8 rounded">Lock Fusions & Reveal Bot</button>
            </div>
        </div>

        <!-- Bot Fusion Reveal Phase -->
        <div id="bot-fusion-phase" class="hidden flex-col items-center bg-gray-900 p-8 comic-border text-center w-full">
            <h2 class="text-4xl bangers-font text-red-500 mb-6">ENEMY FUSIONS GENERATING...</h2>
            <div class="grid grid-cols-2 gap-8 w-full max-w-2xl mb-8">
                <div class="flex flex-col gap-2">
                    <span class="text-gray-400 font-bold">Bot Base 1 & 2</span>
                    <div class="slot-machine-container"><div id="bot-base-1" class="slot-items top-0"></div></div>
                    <div class="slot-machine-container"><div id="bot-base-2" class="slot-items top-0"></div></div>
                </div>
                <div class="flex flex-col gap-2">
                    <span class="text-gray-400 font-bold">Bot Partners 1 & 2</span>
                    <div class="slot-machine-container"><div id="bot-partner-1" class="slot-items top-0"></div></div>
                    <div class="slot-machine-container"><div id="bot-partner-2" class="slot-items top-0"></div></div>
                </div>
            </div>
            <button id="btn-to-fusion-battle" class="hidden bg-red-600 text-white bangers-font text-3xl py-3 px-12 rounded">ENTER SHOWDOWN</button>
        </div>

        <!-- Aura Guesser Phase -->
        <div id="aura-phase" class="hidden flex-col items-center bg-gray-800 p-8 comic-border w-full text-center">
            <h2 class="text-5xl bangers-font text-yellow-400 mb-2">Who Has More Aura?</h2>
            <p class="text-gray-300 mb-8">Spin and select the character with the highest hidden Aura stat!</p>
            
            <div class="flex gap-4 w-full justify-center mb-8">
                <div class="flex flex-col w-1/3">
                    <div class="slot-machine-container h-24 mb-4"><div id="aura-slot-1" class="slot-items top-0 text-2xl"></div></div>
                    <button id="btn-aura-1" class="bg-blue-600 text-white font-bold py-3 rounded disabled:opacity-50">Select 1</button>
                </div>
                <div class="flex flex-col w-1/3">
                    <div class="slot-machine-container h-24 mb-4"><div id="aura-slot-2" class="slot-items top-0 text-2xl"></div></div>
                    <button id="btn-aura-2" class="bg-blue-600 text-white font-bold py-3 rounded disabled:opacity-50">Select 2</button>
                </div>
                <div class="flex flex-col w-1/3">
                    <div class="slot-machine-container h-24 mb-4"><div id="aura-slot-3" class="slot-items top-0 text-2xl"></div></div>
                    <button id="btn-aura-3" class="bg-blue-600 text-white font-bold py-3 rounded disabled:opacity-50">Select 3</button>
                </div>
            </div>
            
            <button id="btn-spin-aura" class="bg-yellow-500 text-black bangers-font text-3xl py-4 px-12 rounded">SPIN AURA</button>
            <div id="aura-result" class="mt-6 text-2xl font-bold hidden"></div>
        </div>

        <!-- The Showdown (Battle Phase) -->
        <div id="battle-phase" class="hidden flex-col items-center w-full bg-gray-900 p-8 comic-border relative">
            <h2 class="text-5xl bangers-font text-white mb-8">The Showdown</h2>
            
            <div class="flex flex-col md:flex-row items-center justify-between w-full z-10 mb-8 gap-4">
                <!-- Player Side -->
                <div class="flex flex-col items-center bg-gray-800 p-4 rounded border-2 border-blue-500 w-full md:w-5/12">
                    <h3 class="text-2xl bangers-font text-blue-400 mb-2" id="battle-p1-name">Your Fighter</h3>
                    <div class="text-4xl text-white font-bold my-2" id="p1-score">--</div>
                    <p class="text-xs text-gray-400">Power Level</p>
                </div>

                <div class="w-16 h-16 bg-red-600 rounded-full flex items-center justify-center bangers-font text-3xl text-white border-4 border-yellow-400">VS</div>

                <!-- Opponent Side -->
                <div class="flex flex-col items-center bg-gray-800 p-4 rounded border-2 border-red-500 w-full md:w-5/12">
                    <h3 class="text-2xl bangers-font text-red-400 mb-2" id="battle-p2-name">Opponent</h3>
                    <div class="text-4xl text-white font-bold my-2" id="p2-score">--</div>
                    <p class="text-xs text-gray-400">Power Level</p>
                    <button id="btn-reveal-stats" class="mt-2 text-xs text-blue-300 underline hidden">👁️ Reveal Enemy Stats</button>
                </div>
            </div>

            <!-- Stat Reveal Panel -->
            <div id="enemy-stats-panel" class="hidden w-full bg-black/80 p-4 rounded border border-red-500 mb-6 text-sm"></div>

            <button id="btn-simulate" class="bg-gradient-to-r from-red-600 to-yellow-500 text-white bangers-font text-4xl py-4 px-12 rounded-full transform transition hover:scale-105">FIGHT!</button>
            <div id="battle-log" class="mt-6 w-full bg-black/50 p-4 rounded border border-gray-700 h-48 overflow-y-auto text-sm font-mono flex-col gap-2 hidden"></div>
        </div>
    </main>

    <!-- Result Modal -->
    <div id="result-modal" class="modal">
        <div class="modal-content comic-border bg-gray-900 p-8 flex flex-col items-center text-center">
            <h2 id="result-title" class="text-6xl bangers-font mb-4">RESULT</h2>
            <p id="result-desc" class="text-lg text-gray-300 mb-6">Description</p>
            <div class="flex gap-4 flex-wrap justify-center">
                <button id="btn-share" class="bg-purple-600 hover:bg-purple-500 text-white font-bold py-2 px-4 rounded">📋 Share Card</button>
                <button id="btn-next-fight" class="hidden bg-green-600 hover:bg-green-500 text-white font-bold py-2 px-4 rounded">Next Opponent!</button>
                <button onclick="goHome()" class="bg-blue-600 hover:bg-blue-500 text-white font-bold py-2 px-4 rounded">Main Menu</button>
            </div>
            <div id="share-toast" class="text-green-400 text-sm mt-2 hidden">Copied to clipboard!</div>
        </div>
    </div>

<script>
// ==========================================
// 1. AUDIO SYSTEM (Tone.js)
// ==========================================
let audioStarted = false; let isMuted = false;
let tickSynth, winSynth, loseSynth, punchSynth;

document.getElementById('btn-mute').addEventListener('click', (e) => {
    isMuted = !isMuted;
    e.target.textContent = isMuted ? '🔇' : '🔊';
});

async function initAudio() {
    if (audioStarted) return;
    await Tone.start();
    tickSynth = new Tone.PolySynth(Tone.Synth, { oscillator: { type: "triangle" }, envelope: { attack: 0.01, decay: 0.1, sustain: 0, release: 0.1 } }).toDestination(); tickSynth.volume.value = -15;
    winSynth = new Tone.PolySynth(Tone.Synth).toDestination(); winSynth.volume.value = -8;
    loseSynth = new Tone.FMSynth().toDestination(); loseSynth.volume.value = -8;
    punchSynth = new Tone.MetalSynth({ frequency: 200, envelope: { attack: 0.001, decay: 0.1, release: 0.01 }, harmonicity: 5.1, modulationIndex: 32, resonance: 4000, octaves: 1.5 }).toDestination(); punchSynth.volume.value = -8;
    audioStarted = true;
}
function playTick() { if (audioStarted && tickSynth && !isMuted) tickSynth.triggerAttackRelease("C6", "32n"); }
function playSelect() { if (audioStarted && winSynth && !isMuted) winSynth.triggerAttackRelease(["C4", "E4", "G4"], "8n"); }
function playPunch() { if (audioStarted && punchSynth && !isMuted) punchSynth.triggerAttackRelease("16n"); }
function playWin() { if (audioStarted && winSynth && !isMuted) winSynth.triggerAttackRelease(["G4", "B4", "D5", "G5"], "2n"); }
function playLose() { if (audioStarted && loseSynth && !isMuted) loseSynth.triggerAttackRelease("C2", "1n"); }

// ==========================================
// 2. UNIVERSES & CHARACTER DATA
// ==========================================
const universes = [
    { id: 'invincible', name: "Invincible Draft", bg: "#1a202c", primary: "#ef4444", secondary: "#facc15" },
    { id: 'marvel', name: "Marvel Draft", bg: "#2d1616", primary: "#e11d48", secondary: "#ffffff" },
    { id: 'dc', name: "DC Draft", bg: "#111827", primary: "#2563eb", secondary: "#facc15" },
    { id: 'theboys', name: "The Boys Draft", bg: "#000000", primary: "#dc2626", secondary: "#6b7280" },
    { id: 'simpsons', name: "Simpsons Draft", bg: "#1e3a8a", primary: "#facc15", secondary: "#38bdf8" },
    { id: 'sheldon', name: "Young Sheldon Draft", bg: "#1e293b", primary: "#10b981", secondary: "#fcd34d" },
    { id: 'ultimate', name: "Ultimate Draft", bg: "#171717", primary: "#a855f7", secondary: "#3b82f6" }
];
let uniIdx = 0;

const allCharacters = [
    // INVINCIBLE
    { name: "Omni-Man", uni: "invincible", strength: 9.5, speed: 9.5, agility: 8.5, durability: 9, biq: 8, powers: 7, gear: 1, ruthlessness: 9, aura: 10, color: "#ef4444" },
    { name: "Invincible", uni: "invincible", strength: 8, speed: 8.5, agility: 8, durability: 8.5, biq: 6, powers: 6, gear: 1, ruthlessness: 4, aura: 8, color: "#facc15" },
    { name: "Atom Eve", uni: "invincible", strength: 3, speed: 6, agility: 6, durability: 4, biq: 7, powers: 10, gear: 1, ruthlessness: 3, aura: 7, color: "#f472b6" },
    { name: "Battle Beast", uni: "invincible", strength: 10, speed: 8, agility: 9, durability: 9.5, biq: 9, powers: 2, gear: 8, ruthlessness: 10, aura: 10, color: "#d97706" },
    { name: "Thragg", uni: "invincible", strength: 10, speed: 10, agility: 10, durability: 10, biq: 9, powers: 7, gear: 1, ruthlessness: 10, aura: 10, color: "#991b1b" },
    { name: "Conquest", uni: "invincible", strength: 9.8, speed: 9, agility: 8, durability: 9.5, biq: 8, powers: 6, gear: 3, ruthlessness: 10, aura: 9, color: "#7f1d1d" },
    { name: "Space Racer", uni: "invincible", strength: 5, speed: 9, agility: 9, durability: 6, biq: 8, powers: 5, gear: 10, ruthlessness: 7, aura: 8, color: "#a78bfa" },
    { name: "Robot", uni: "invincible", strength: 7, speed: 6, agility: 5, durability: 7, biq: 10, powers: 8, gear: 10, ruthlessness: 8, aura: 6, color: "#94a3b8" },
    { name: "Cecil Stedman", uni: "invincible", strength: 1, speed: 1, agility: 2, durability: 1, biq: 10, powers: 0, gear: 10, ruthlessness: 9, aura: 8, color: "#4b5563" },
    { name: "The Immortal", uni: "invincible", strength: 7.5, speed: 7, agility: 7, durability: 7, biq: 7, powers: 5, gear: 2, ruthlessness: 6, aura: 7, color: "#3b82f6" },
    { name: "Debbie Grayson", uni: "invincible", strength: 1, speed: 1, agility: 2, durability: 1, biq: 6, powers: 0, gear: 3, ruthlessness: 7, aura: 9, color: "#fca5a5" },
    { name: "Mauler Twins", uni: "invincible", strength: 7, speed: 4, agility: 4, durability: 7, biq: 8, powers: 3, gear: 9, ruthlessness: 7, aura: 6, color: "#0ea5e9" },
    { name: "Allen the Alien", uni: "invincible", strength: 8.5, speed: 8, agility: 7, durability: 9, biq: 6, powers: 4, gear: 1, ruthlessness: 5, aura: 7, color: "#f97316" },

    // MARVEL
    { name: "Spider-Man", uni: "marvel", strength: 6, speed: 7, agility: 10, durability: 6, biq: 8, powers: 6, gear: 7, ruthlessness: 2, aura: 9, color: "#ef4444" },
    { name: "Iron Man", uni: "marvel", strength: 7, speed: 8, agility: 6, durability: 8, biq: 10, powers: 7, gear: 10, ruthlessness: 5, aura: 8, color: "#facc15" },
    { name: "Hulk", uni: "marvel", strength: 10, speed: 6, agility: 4, durability: 10, biq: 3, powers: 8, gear: 1, ruthlessness: 8, aura: 9, color: "#22c55e" },
    { name: "Thor", uni: "marvel", strength: 9, speed: 8, agility: 6, durability: 9, biq: 7, powers: 10, gear: 9, ruthlessness: 6, aura: 9, color: "#38bdf8" },
    { name: "Thanos", uni: "marvel", strength: 10, speed: 6, agility: 5, durability: 10, biq: 10, powers: 9, gear: 8, ruthlessness: 10, aura: 10, color: "#a855f7" },
    { name: "Galactus", uni: "marvel", strength: 10, speed: 10, agility: 2, durability: 10, biq: 10, powers: 10, gear: 1, ruthlessness: 8, aura: 10, color: "#c026d3" },
    { name: "Wolverine", uni: "marvel", strength: 5, speed: 6, agility: 7, durability: 9, biq: 8, powers: 7, gear: 8, ruthlessness: 10, aura: 9, color: "#f59e0b" },
