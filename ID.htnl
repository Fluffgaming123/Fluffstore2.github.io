const categories = [
    { id: "strength", name: "Strength" }, { id: "speed", name: "Speed" },
    { id: "agility", name: "Agility" }, { id: "durability", name: "Durability" },
    { id: "biq", name: "Battle IQ" }, { id: "powers", name: "Powers/Hax" },
    { id: "gear", name: "Weaponry/Gear" }, { id: "ruthlessness", name: "Ruthlessness" }
];

// Context
let currentMode = ""; 
let gauntletStreak = 0;
let hasRerolled = false;
let isAssigning = false; // Prevent double click bugs

// Chimera / PVP Data
let p1Fighter = {}, p2Fighter = {}; 
let draftsCompleted = 0;
let isP2Turn = false;
let optA = null, optB = null;

// Fusion Data
let fusionBases = [], fusionPartners = [];
let botBases = [], botPartners = [];
let p1Fusions = [], p2Fusions = []; // Objects with calculated fused stats

// ==========================================
// 3. UI THEME & UNIVERSE LOGIC
// ==========================================
function getPool() {
    if (universes[uniIdx].id === 'ultimate') return allCharacters;
    return allCharacters.filter(c => c.uni === universes[uniIdx].id);
}
function getRandomChar() {
    const pool = getPool(); return pool[Math.floor(Math.random() * pool.length)];
}

function updateTheme() {
    const u = universes[uniIdx];
    document.getElementById('main-title').textContent = u.name;
    document.getElementById('main-title').style.color = u.primary;
    document.getElementById('body-bg').style.backgroundColor = u.bg;
}

document.getElementById('btn-prev-uni').onclick = () => { uniIdx = (uniIdx - 1 + universes.length) % universes.length; updateTheme(); };
document.getElementById('btn-next-uni').onclick = () => { uniIdx = (uniIdx + 1) % universes.length; updateTheme(); };

updateTheme(); // Init

// ==========================================
// 4. ANIMATIONS & SLOTS
// ==========================================
function populateSlot(el, finalChar, count = 20) {
    el.innerHTML = '';
    for(let i=0; i<count; i++) {
        const d = document.createElement('div'); d.className = 'slot-item';
        const rc = getRandomChar(); d.textContent = rc.name; d.style.color = rc.color;
        el.appendChild(d);
    }
    const fd = document.createElement('div'); fd.className = 'slot-item text-xl font-black';
    fd.textContent = finalChar.name; fd.style.color = finalChar.color;
    el.appendChild(fd);
    el.style.transition = 'none'; el.style.top = '0px';
}

function spinSlot(el, count = 20, duration = 1500) {
    return new Promise(resolve => {
        void el.offsetWidth;
        el.style.transition = `top ${duration}ms cubic-bezier(0.25, 1, 0.5, 1)`;
        el.style.top = `-${count * 60}px`;
        let t=0; const int = setInterval(()=>{ playTick(); t++; if(t>=10) clearInterval(int); }, duration/10);
        setTimeout(()=>{ clearInterval(int); resolve(); }, duration+50);
    });
}
const wait = ms => new Promise(r => setTimeout(r, ms));

function hideAll() {
    ['main-menu', 'setup-phase', 'draft-phase', 'pvp-intermission', 'fusion-setup-phase', 'bot-fusion-phase', 'aura-phase', 'battle-phase'].forEach(id => {
        document.getElementById(id).classList.add('hidden');
        document.getElementById(id).classList.remove('flex');
    });
}

function goHome() {
    hideAll();
    document.getElementById('main-menu').classList.remove('hidden');
    document.getElementById('main-menu').classList.add('flex');
    document.getElementById('game-container').classList.add('hidden');
    document.getElementById('result-modal').style.display = 'none';
    document.getElementById('share-toast').classList.add('hidden');
}

// ==========================================
// 5. MODES LOGIC
// ==========================================
function startGame(mode) {
    initAudio();
    currentMode = mode;
    gauntletStreak = 0;
    document.getElementById('game-container').classList.remove('hidden');
    document.getElementById('main-menu').classList.add('hidden');
    document.getElementById('main-menu').classList.remove('flex');
    
    if(mode === 'chimera' || mode === 'pvp') {
        p1Fighter = {}; p2Fighter = {};
        if(mode === 'chimera') { startOpponentSpin(); }
        else { isP2Turn = false; startDraftingPhase(); } // PVP skips opponent spin
    } 
    else if(mode === 'fusion') {
        startFusionPhase();
    }
    else if(mode === 'aura') {
        startAuraPhase();
    }
}

// --- CHIMERA / PVP DRAFT LOGIC ---
async function startOpponentSpin() {
    hideAll(); document.getElementById('setup-phase').classList.add('flex'); document.getElementById('setup-phase').classList.remove('hidden');
    document.getElementById('opponent-reveal').classList.add('hidden');
    document.getElementById('btn-spin-opponent').disabled = false;
    
    // Create bot stats directly
    const bot = getRandomChar();
    p2Fighter = {}; categories.forEach(c => p2Fighter[c.id] = bot);
    
    document.getElementById('btn-spin-opponent').onclick = async (e) => {
        e.target.disabled = true;
        const el = document.getElementById('opponent-slot');
        populateSlot(el, bot, 30);
        await spinSlot(el, 30, 2000);
        document.getElementById('opponent-name-display').textContent = bot.name;
        document.getElementById('opponent-name-display').style.color = bot.color;
        document.getElementById('opponent-reveal').classList.remove('hidden');
    };
    document.getElementById('btn-start-draft').onclick = startDraftingPhase;
}

function startDraftingPhase() {
    hideAll(); document.getElementById('draft-phase').classList.add('flex'); document.getElementById('draft-phase').classList.remove('hidden');
    draftsCompleted = 0; hasRerolled = false; isAssigning = false;
    document.getElementById('btn-reroll').disabled = false;
    document.getElementById('btn-reroll').textContent = "REROLL";
    document.getElementById('gauntlet-streak').textContent = gauntletStreak;
    
    document.getElementById('draft-turn-indicator').textContent = (currentMode==='pvp' && isP2Turn) ? "Player 2 Draft" : "Draft Phase";
    document.getElementById('sidebar-title').textContent = (currentMode==='pvp' && isP2Turn) ? "P2 Fighter" : "Your Fighter";
    document.getElementById('summary-opponent-name').textContent = currentMode==='chimera' ? p2Fighter.strength.name : (isP2Turn ? "Player 1" : "Player 2");
    
    renderSidebarStats();
    resetSpinners();
}

function renderSidebarStats() {
    const c = document.getElementById('fighter-stats-container'); c.innerHTML = '';
    const activeFighter = isP2Turn ? p2Fighter : p1Fighter;
    categories.forEach(cat => {
        const div = document.createElement('div'); div.className = 'stat-row';
        const val = activeFighter[cat.id] ? activeFighter[cat.id].name : '???';
        const color = activeFighter[cat.id] ? activeFighter[cat.id].color : '#fde047';
        div.innerHTML = `<div class="stat-label">${cat.name}</div><div class="stat-val" style="color:${color}">${val}</div>`;
        c.appendChild(div);
    });
    document.getElementById('draft-progress').textContent = draftsCompleted;
}

function resetSpinners() {
    document.getElementById('assignment-panel').classList.add('hidden');
    document.getElementById('btn-spin-draft').disabled = false;
    document.getElementById('btn-select-a').disabled = true; document.getElementById('btn-select-b').disabled = true;
    document.getElementById('draft-slot-a').style.top = '0px'; document.getElementById('draft-slot-a').innerHTML = '<div class="slot-item text-gray-500">?</div>';
    document.getElementById('draft-slot-b').style.top = '0px'; document.getElementById('draft-slot-b').innerHTML = '<div class="slot-item text-gray-500">?</div>';
}

document.getElementById('btn-spin-draft').onclick = async (e) => {
    e.target.disabled = true; document.getElementById('btn-reroll').disabled = true;
    optA = getRandomChar(); do { optB = getRandomChar(); } while(optB.name === optA.name);
    populateSlot(document.getElementById('draft-slot-a'), optA, 20); populateSlot(document.getElementById('draft-slot-b'), optB, 25);
    await Promise.all([spinSlot(document.getElementById('draft-slot-a'), 20, 1000), spinSlot(document.getElementById('draft-slot-b'), 25, 1200)]);
    document.getElementById('btn-select-a').disabled = false; document.getElementById('btn-select-b').disabled = false;
    if(!hasRerolled) document.getElementById('btn-reroll').disabled = false;
};

document.getElementById('btn-reroll').onclick = (e) => {
    hasRerolled = true; e.target.disabled = true; e.target.textContent = "USED";
    document.getElementById('btn-spin-draft').click();
};

document.getElementById('btn-select-a').onclick = () => showAssignment(optA);
document.getElementById('btn-select-b').onclick = () => showAssignment(optB);

function showAssignment(char) {
    if(isAssigning) return;
    document.getElementById('assign-char-name').textContent = char.name;
    document.getElementById('assign-char-name').style.color = char.color;
    const c = document.getElementById('category-buttons'); c.innerHTML = '';
    const activeFighter = isP2Turn ? p2Fighter : p1Fighter;
    
    categories.forEach(cat => {
        const btn = document.createElement('button');
        const isFilled = !!activeFighter[cat.id];
        btn.className = `py-2 px-1 text-xs font-bold rounded ${isFilled ? 'bg-gray-700 text-gray-500 cursor-not-allowed' : 'bg-blue-600 hover:bg-blue-500 text-white'}`;
        btn.textContent = cat.name; btn.disabled = isFilled;
        if(!isFilled) btn.onclick = () => confirmAssign(cat.id, char);
        c.appendChild(btn);
    });
    document.getElementById('assignment-panel').classList.remove('hidden'); document.getElementById('assignment-panel').classList.add('flex');
}

function confirmAssign(catId, char) {
    if(isAssigning) return; isAssigning = true;
    playSelect();
    if(isP2Turn) p2Fighter[catId] = char; else p1Fighter[catId] = char;
    draftsCompleted++; renderSidebarStats();
    
    if(draftsCompleted >= 8) {
        if(currentMode === 'pvp' && !isP2Turn) {
            hideAll(); document.getElementById('pvp-intermission').classList.add('flex'); document.getElementById('pvp-intermission').classList.remove('hidden');
        } else {
            setupBattle();
        }
    } else {
        isAssigning = false; resetSpinners();
    }
}
function startPlayer2Draft() { isP2Turn = true; startDraftingPhase(); }

// --- FUSION LOGIC ---
function startFusionPhase() {
    hideAll(); document.getElementById('fusion-setup-phase').classList.add('flex'); document.getElementById('fusion-setup-phase').classList.remove('hidden');
    fusionBases = []; fusionPartners = []; botBases = []; botPartners = [];
    document.getElementById('fusion-assignment').classList.add('hidden');
    document.getElementById('btn-spin-bases').disabled = false; document.getElementById('btn-spin-partners').disabled = true;
}

document.getElementById('btn-spin-bases').onclick = async (e) => {
    e.target.disabled = true;
    fusionBases = [getRandomChar(), getRandomChar()];
    populateSlot(document.getElementById('fusion-base-1'), fusionBases[0], 20); populateSlot(document.getElementById('fusion-base-2'), fusionBases[1], 25);
    await Promise.all([spinSlot(document.getElementById('fusion-base-1'), 20, 1000), spinSlot(document.getElementById('fusion-base-2'), 25, 1200)]);
    document.getElementById('btn-spin-partners').disabled = false;
};

document.getElementById('btn-spin-partners').onclick = async (e) => {
    e.target.disabled = true;
    fusionPartners = [getRandomChar(), getRandomChar()];
    populateSlot(document.getElementById('fusion-partner-1'), fusionPartners[0], 20); populateSlot(document.getElementById('fusion-partner-2'), fusionPartners[1], 25);
    await Promise.all([spinSlot(document.getElementById('fusion-partner-1'), 20, 1000), spinSlot(document.getElementById('fusion-partner-2'), 25, 1200)]);
    
    // Setup Assignment Dropdown
    document.getElementById('label-base-1').textContent = fusionBases[0].name; document.getElementById('label-base-1').style.color = fusionBases[0].color;
    document.getElementById('label-base-2').textContent = fusionBases[1].name; document.getElementById('label-base-2').style.color = fusionBases[1].color;
    const sel = document.getElementById('select-partner-1'); sel.innerHTML = '';
    sel.innerHTML += `<option value="0">${fusionPartners[0].name}</option><option value="1">${fusionPartners[1].name}</option>`;
    
    sel.onchange = () => {
        const val = parseInt(sel.value);
        const otherVal = val === 0 ? 1 : 0;
        document.getElementById('label-partner-2').textContent = fusionPartners[otherVal].name;
        document.getElementById('label-partner-2').style.color = fusionPartners[otherVal].color;
    };
    sel.onchange();
    document.getElementById('fusion-assignment').classList.remove('hidden');
};

document.getElementById('btn-lock-fusions').onclick = async () => {
    const idx1 = parseInt(document.getElementById('select-partner-1').value);
    const idx2 = idx1 === 0 ? 1 : 0;
    
    // Create fused objects
    p1Fusions = [ fuse(fusionBases[0], fusionPartners[idx1]), fuse(fusionBases[1], fusionPartners[idx2]) ];
    
    // Transition to Bot Draft Reveal
    hideAll(); document.getElementById('bot-fusion-phase').classList.add('flex'); document.getElementById('bot-fusion-phase').classList.remove('hidden');
    document.getElementById('btn-to-fusion-battle').classList.add('hidden');
    
    botBases = [getRandomChar(), getRandomChar()]; botPartners = [getRandomChar(), getRandomChar()];
    populateSlot(document.getElementById('bot-base-1'), botBases[0], 20); populateSlot(document.getElementById('bot-base-2'), botBases[1], 25);
    populateSlot(document.getElementById('bot-partner-1'), botPartners[0], 20); populateSlot(document.getElementById('bot-partner-2'), botPartners[1], 25);
    
    playTick(); // start sound
    await Promise.all([
        spinSlot(document.getElementById('bot-base-1'), 20, 1500), spinSlot(document.getElementById('bot-base-2'), 25, 1800),
        spinSlot(document.getElementById('bot-partner-1'), 20, 1500), spinSlot(document.getElementById('bot-partner-2'), 25, 1800)
    ]);
    
    p2Fusions = [ fuse(botBases[0], botPartners[0]), fuse(botBases[1], botPartners[1]) ];
    document.getElementById('btn-to-fusion-battle').classList.remove('hidden');
};

document.getElementById('btn-to-fusion-battle').onclick = setupBattle;

function fuse(char1, char2) {
    const f = { name: `${char1.name} & ${char2.name}`, color: char1.color };
    categories.forEach(c => f[c.id] = Math.max(char1[c.id], char2[c.id])); // Take best stat
    return f;
}

// --- AURA GUESSER ---
function startAuraPhase() {
    hideAll(); document.getElementById('aura-phase').classList.add('flex'); document.getElementById('aura-phase').classList.remove('hidden');
    document.getElementById('btn-spin-aura').disabled = false;
    document.getElementById('aura-result').classList.add('hidden');
    [1,2,3].forEach(i => document.getElementById(`btn-aura-${i}`).disabled = true);
}

let auraChars = [];
document.getElementById('btn-spin-aura').onclick = async (e) => {
    e.target.disabled = true; document.getElementById('aura-result').classList.add('hidden');
    auraChars = [getRandomChar(), getRandomChar(), getRandomChar()];
    
    [1,2,3].forEach(i => populateSlot(document.getElementById(`aura-slot-${i}`), auraChars[i-1], 20+i*5));
    await Promise.all([
        spinSlot(document.getElementById('aura-slot-1'), 25, 1000),
        spinSlot(document.getElementById('aura-slot-2'), 30, 1200),
        spinSlot(document.getElementById('aura-slot-3'), 35, 1400)
    ]);
    
    [1,2,3].forEach(i => {
        const btn = document.getElementById(`btn-aura-${i}`);
        btn.disabled = false;
        btn.onclick = () => resolveAura(i-1);
    });
};

function resolveAura(selectedIndex) {
    [1,2,3].forEach(i => document.getElementById(`btn-aura-${i}`).disabled = true);
    const maxAura = Math.max(...auraChars.map(c => c.aura));
    const picked = auraChars[selectedIndex];
    
    const res = document.getElementById('aura-result'); res.classList.remove('hidden');
    res.innerHTML = auraChars.map(c => `<span style="color:${c.color}">${c.name}: ${c.aura} Aura</span>`).join('<br>');
    
    if(picked.aura >= maxAura) {
        playWin(); res.innerHTML += `<br><span class="text-green-400 text-4xl mt-4 block">CORRECT!</span>`;
    } else {
        playLose(); res.innerHTML += `<br><span class="text-red-500 text-4xl mt-4 block">WRONG!</span>`;
    }
    setTimeout(() => { document.getElementById('btn-spin-aura').disabled = false; }, 1500);
}

// ==========================================
// 6. BATTLE CALCULATION & SHOWDOWN
// ==========================================
function setupBattle() {
    hideAll(); document.getElementById('battle-phase').classList.add('flex'); document.getElementById('battle-phase').classList.remove('hidden');
    document.getElementById('p1-score').textContent = '--'; document.getElementById('p2-score').textContent = '--';
    document.getElementById('battle-log').innerHTML = ''; document.getElementById('battle-log').classList.add('hidden');
    document.getElementById('enemy-stats-panel').classList.add('hidden');
    
    const btnSim = document.getElementById('btn-simulate');
    btnSim.classList.remove('hidden'); btnSim.disabled = false;
    
    if(currentMode === 'chimera') {
        document.getElementById('battle-p1-name').textContent = "Your Chimera";
        document.getElementById('battle-p2-name').textContent = p2Fighter.strength.name; // Uses bot base
    } else if(currentMode === 'pvp') {
        document.getElementById('battle-p1-name').textContent = "P1 Chimera";
        document.getElementById('battle-p2-name').textContent = "P2 Chimera";
    } else if(currentMode === 'fusion') {
        document.getElementById('battle-p1-name').textContent = "Your Team";
        document.getElementById('battle-p2-name').textContent = "Enemy Team";
    }

    // Setup Stat Reveal
    document.getElementById('btn-reveal-stats').classList.remove('hidden');
    let revealHtml = `<div class="grid grid-cols-2 gap-2">`;
    categories.forEach(c => {
        let val = 0;
        if(currentMode === 'fusion') val = Math.max(p2Fusions[0][c.id], p2Fusions[1][c.id]);
        else if(currentMode === 'pvp') val = p2Fighter[c.id] ? p2Fighter[c.id][c.id] : 0;
        else val = p2Fighter[c.id] ? p2Fighter[c.id][c.id] : 0;
        revealHtml += `<div><span class="text-gray-400">${c.name}:</span> <span class="text-white font-bold">${val}</span></div>`;
    });
    revealHtml += `</div>`;
    document.getElementById('enemy-stats-panel').innerHTML = revealHtml;
}

document.getElementById('btn-reveal-stats').onclick = () => {
    document.getElementById('enemy-stats-panel').classList.toggle('hidden');
};

function calcPower(val, isPhysical) {
    if(!val) return 0;
    return Math.pow(val, 2) * (isPhysical ? 1.5 : 1.0);
}

document.getElementById('btn-simulate').onclick = async (e) => {
    e.target.disabled = true; e.target.classList.add('hidden');
    const log = document.getElementById('battle-log'); log.classList.remove('hidden'); log.classList.add('flex');
    const addLog = (msg, c="text-green-400") => { log.innerHTML += `<p class="${c}">> ${msg}</p>`; log.scrollTop = log.scrollHeight; };
    
    addLog("CALCULATING POWER LEVELS...", "text-blue-400"); await wait(1000);
    
    let s1=0, s2=0;
    categories.forEach(c => {
        const isPhys = ['strength','speed','durability','powers'].includes(c.id);
        if(currentMode === 'chimera' || currentMode === 'pvp') {
            s1 += calcPower(p1Fighter[c.id] ? p1Fighter[c.id][c.id] : 0, isPhys);
            s2 += calcPower(p2Fighter[c.id] ? p2Fighter[c.id][c.id] : 0, isPhys);
        } else {
            s1 += calcPower(p1Fusions[0][c.id], isPhys) + calcPower(p1Fusions[1][c.id], isPhys);
            s2 += calcPower(p2Fusions[0][c.id], isPhys) + calcPower(p2Fusions[1][c.id], isPhys);
        }
    });

    s1 = Math.round(s1 * 10 * (1 + (Math.random()*0.1 - 0.05)));
    s2 = Math.round(s2 * 10 * (1 + (Math.random()*0.1 - 0.05)));
    
    // Gauntlet Scaling applies to Bot in Chimera/Fusion
    if(currentMode !== 'pvp') s2 = Math.round(s2 * (1 + (gauntletStreak * 0.15)));

    await animateCounter(document.getElementById('p1-score'), 0, s1, 1500);
    await animateCounter(document.getElementById('p2-score'), 0, s2, 1500);
    await wait(1000);
    
    if(s1 > s2 + 1000) { playWin(); showModal("VICTORY", "Total Domination.", true); }
    else if (s1 > s2) { playWin(); showModal("NARROW WIN", "A brutal, close fight.", true); }
    else if (s2 > s1 + 1000) { playLose(); showModal("ANNIHILATION", "You were turned to paste.", false); }
    else { playLose(); showModal("DEFEAT", "You fought well, but fell at the end.", false); }
};

function animateCounter(el, start, end, dur) {
    return new Promise(res => {
        let st = null;
        const step = (ts) => {
            if(!st) st = ts; const p = Math.min((ts-st)/dur, 1);
            el.textContent = Math.round(start + (1 - Math.pow(1-p, 4))*(end-start)).toLocaleString();
            if(p<1) requestAnimationFrame(step); else res();
        };
        requestAnimationFrame(step);
    });
}

function showModal(title, desc, won) {
    document.getElementById('result-title').textContent = title;
    document.getElementById('result-title').className = `text-6xl bangers-font mb-4 ${won?'text-yellow-400':'text-red-500'}`;
    document.getElementById('result-desc').textContent = desc;
    document.getElementById('result-modal').style.display = 'block';
    
    const nxtBtn = document.getElementById('btn-next-fight');
    if(won && currentMode !== 'pvp') {
        nxtBtn.classList.remove('hidden');
        nxtBtn.onclick = () => { gauntletStreak++; document.getElementById('result-modal').style.display='none'; 
            if(currentMode==='chimera') startOpponentSpin(); else startFusionPhase(); 
        };
    } else { nxtBtn.classList.add('hidden'); }
}

// --- SHARE CARD ---
document.getElementById('btn-share').onclick = () => {
    let text = `🔥 UNIVERSAL DRAFT BATTLE 🔥\nMode: ${currentMode.toUpperCase()}\n`;
    if(currentMode==='chimera' || currentMode==='pvp') {
        categories.forEach(c => { text += `${c.name}: ${p1Fighter[c.id]?p1Fighter[c.id].name:'N/A'}\n`; });
    } else if(currentMode==='fusion') {
        text += `Fusion 1: ${p1Fusions[0].name}\nFusion 2: ${p1Fusions[1].name}\n`;
    }
    text += `Power Level: ${document.getElementById('p1-score').textContent}\nPlay now!`;
    navigator.clipboard.writeText(text).then(()=>{
        document.getElementById('share-toast').classList.remove('hidden');
        setTimeout(()=>document.getElementById('share-toast').classList.add('hidden'), 2000);
    }).catch(()=>{
        const t = document.createElement('textarea'); t.value = text; document.body.appendChild(t); t.select(); document.execCommand('copy'); document.body.removeChild(t);
        document.getElementById('share-toast').classList.remove('hidden');
        setTimeout(()=>document.getElementById('share-toast').classList.add('hidden'), 2000);
    });
};

</script>
</body>
</html>

```
